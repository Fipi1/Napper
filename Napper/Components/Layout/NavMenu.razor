<div class="mobile-menu-bar">
    <a class="navbar-brand" href="">
        <span class="brand-mark">N</span>
        <span class="brand-copy">
            <strong>Napper</strong>
            <small>Bebisens somnplan</small>
        </span>
    </a>

    <button type="button"
            class="menu-toggle-button"
            aria-label="Oppna meny"
            aria-expanded="@isMobileMenuOpen"
            @onclick="ToggleMobileMenu">
    </button>
</div>

<div class="menu-top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="brand-mark">N</span>
            <span class="brand-copy">
                <strong>Napper</strong>
                <small>Bebisens somnplan</small>
            </span>
        </a>
    </div>
</div>

<div class="nav-scrollable @(isMobileMenuOpen ? "open" : string.Empty)" @onclick="CloseMobileMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Oversikt
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <a class="nav-link nav-link-muted" href="#logga">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Logga
            </a>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="historik">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Historik
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="profil">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Profil
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <a class="nav-link nav-link-muted" href="/">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Guider
            </a>
        </div>
    </nav>
</div>

@code {
    private bool isMobileMenuOpen;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }
}
